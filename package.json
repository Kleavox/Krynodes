{
  "name": "kry",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.17.0",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --parallel",
    "lint": "pnpm format:check && pnpm knip && pnpm lint:async && pnpm lint:patterns && pnpm lint:actions",
    "lint:async": "node tooling/lint/unhandled-async.mjs",
    "lint:patterns": "node tooling/lint/html-patterns.mjs",
    "lint:actions": "node tooling/lint/pinned-actions.mjs",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck && tsc -p tsconfig.tooling.json --noEmit --checkers 1",
    "agent:test": "go -C agent test ./...",
    "agent:vet": "go -C agent vet ./...",
    "agent:build": "go -C agent build -buildvcs=false -o ../bin/ ./cmd/agent",
    "agent:deadcode": "node tooling/lint/go-deadcode.mjs",
    "native:check": "pnpm agent:test && pnpm agent:vet && pnpm agent:build && pnpm agent:deadcode",
    "check": "pnpm lint && pnpm typecheck && turbo run test build",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "knip": "knip --no-config-hints",
    "check:native": "pnpm native:check"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "catalog:",
    "@types/node": "catalog:",
    "knip": "^6.45.1",
    "prettier": "^3.10.0",
    "turbo": "^2.11.10",
    "typescript": "catalog:",
    "wrangler": "catalog:"
  }
}
