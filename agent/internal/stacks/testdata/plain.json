{
  "name": "web",
  "networks": {
    "default": {
      "name": "web_default",
      "ipam": {}
    }
  },
  "services": {
    "app": {
      "command": null,
      "entrypoint": null,
      "environment": {
        "TZ": "UTC"
      },
      "image": "nginx:1.27",
